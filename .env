# I keep local environment variables here so the app can read DB creds
# without hardcoding. Do NOT commit secrets in real projects.

FLASK_DEBUG=1
SECRET_KEY=dev-secret-change-later
DATABASE_URL=postgresql+psycopg2://postgres:secret@localhost:5433/GG-database

# Note: your environment currently maps host 5433 -> container 5432,
# so I set the port to 5433 to match.
